<!DOCTYPE html>
<html>
<%- include('partials/header', { title: 'Admin Dashboard' }) %>
<body>

    <div class="container-fluid">
        <div class="row">
            
            <!-- Sidebar -->
            <%- include('partials/sidebar', { activeTab: 'admin-dashboard' }) %>
            
            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                
                <!-- Navbar -->
                <%- include('partials/navbar') %>
                
                <!-- Notifications -->
                <div class="mt-4">
                    <% if (success) { %>
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span><%= success %></span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>
                    
                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <span><%= error %></span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>
                </div>

                <!-- Page Title -->
                <div class="d-flex justify-content-between align-items-center my-4">
                    <div>
                        <h2 class="fw-bold mb-1">Admin Control Panel</h2>
                        <p class="text-muted mb-0">Monitor overall system metrics and manage active users</p>
                    </div>
                    <button class="btn btn-primary px-4 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#addUserModal">
                        <i class="bi bi-person-plus me-1"></i> Add User
                    </button>
                </div>

                <!-- Overall System Reports Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="card stat-card p-4 bg-white">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-primary-light text-primary me-3">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                                <div>
                                    <h6 class="text-muted mb-1">Total Active Users</h6>
                                    <h4 class="fw-bold mb-0 text-primary"><%= totalUsers %></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card stat-card p-4 bg-white">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-success-light text-success me-3">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <div>
                                    <h6 class="text-muted mb-1">Total System Income</h6>
                                    <h4 class="fw-bold mb-0 text-success">₹<%= formatDecimal(totalIncome) %></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card stat-card p-4 bg-white">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-danger-light text-danger me-3">
                                    <i class="bi bi-cart-dash-fill"></i>
                                </div>
                                <div>
                                    <h6 class="text-muted mb-1">Total System Expenses</h6>
                                    <h4 class="fw-bold mb-0 text-danger">₹<%= formatDecimal(totalExpense) %></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Management Table -->
                <div class="card border-0 shadow-sm p-4 bg-white">
                    <h5 class="fw-bold mb-4">System User Directory</h5>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>User Details</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% usersList.forEach(function(u) { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="<%= u.profilePicture ? u.profilePicture : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" alt="" width="40" height="40" class="rounded-circle me-3">
                                                <div>
                                                    <strong class="d-block"><%= u.name %></strong>
                                                    <span class="text-muted small"><%= u.email %></span>
                                                </div>
                                            </div>
                                        </td>
                                        <td><%= u.phone ? u.phone : 'N/A' %></td>
                                        <td>
                                            <span class="badge py-2 px-3 rounded-pill <%= u.active ? 'bg-success-light text-success' : 'bg-secondary-light text-secondary' %>">
                                                <%= u.active ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-secondary me-1 edit-user-btn"
                                                    data-id="<%= u._id %>"
                                                    data-name="<%= u.name %>"
                                                    data-email="<%= u.email %>"
                                                    data-phone="<%= u.phone || '' %>"
                                                    data-bs-toggle="modal" data-bs-target="#editUserModal">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <a href="/admin/users/toggle/<%= u._id %>" class="btn btn-sm me-1 <%= u.active ? 'btn-outline-warning' : 'btn-outline-success' %>" 
                                               title="<%= u.active ? 'Deactivate User' : 'Activate User' %>">
                                                <i class="<%= u.active ? 'bi bi-person-x-fill' : 'bi bi-person-check-fill' %>"></i>
                                            </a>
                                            <a href="/admin/users/delete/<%= u._id %>" class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Are you sure you want to delete this user? All their financial records will be permanently removed!');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                                <% if (usersList.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No registered users in the database.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- ADD USER MODAL -->
    <div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="addUserModalLabel">Create System User</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/admin/users/add" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="addName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="addName" name="name" required placeholder="John Doe">
                        </div>
                        <div class="mb-3">
                            <label for="addEmail" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="addEmail" name="email" required placeholder="john@example.com">
                        </div>
                        <div class="mb-3">
                            <label for="addPhone" class="form-label">Phone Number</label>
                            <input type="text" class="form-control" id="addPhone" name="phone" placeholder="1234567890">
                        </div>
                        <div class="mb-0">
                            <label for="addPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="addPassword" name="password" required placeholder="Set user password">
                        </div>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4">
                        <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- EDIT USER MODAL -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="editUserModalLabel">Modify User Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/admin/users/edit" method="POST">
                    <input type="hidden" id="editId" name="id">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="editName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="editName" name="name" required placeholder="John Doe">
                        </div>
                        <div class="mb-3">
                            <label for="editEmail" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="editEmail" name="email" required placeholder="john@example.com">
                        </div>
                        <div class="mb-0">
                            <label for="editPhone" class="form-label">Phone Number</label>
                            <input type="text" class="form-control" id="editPhone" name="phone" placeholder="1234567890">
                        </div>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4">
                        <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark px-4">Update Details</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('partials/footer_scripts') %>
    
    <!-- Script to populate edit modal data dynamically -->
    <script>
        document.querySelectorAll('.edit-user-btn').forEach(button => {
            button.addEventListener('click', function() {
                document.getElementById('editId').value = this.getAttribute('data-id');
                document.getElementById('editName').value = this.getAttribute('data-name');
                document.getElementById('editEmail').value = this.getAttribute('data-email');
                document.getElementById('editPhone').value = this.getAttribute('data-phone');
            });
        });
    </script>
</body>
</html>
