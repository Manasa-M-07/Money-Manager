<!DOCTYPE html>
<html>
<%- include('partials/header', { title: 'Financial Reports' }) %>
<body>

    <div class="container-fluid">
        <div class="row">
            
            <!-- Sidebar -->
            <%- include('partials/sidebar', { activeTab: 'reports' }) %>
            
            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                
                <!-- Navbar -->
                <%- include('partials/navbar') %>

                <!-- Title -->
                <div class="my-4">
                    <h2 class="fw-bold mb-1">Financial Reports</h2>
                    <p class="text-muted mb-0">Generate, search, and filter detailed reports on your finances</p>
                </div>

                <!-- Report Type Switcher & Filters -->
                <div class="card border-0 shadow-sm p-4 mb-4 bg-white">
                    <h5 class="fw-bold mb-3">Filters</h5>
                    
                    <form action="/dashboard/reports" method="GET">
                        <div class="row g-3 align-items-end">
                            
                            <!-- Type Switcher -->
                            <div class="col-md-2">
                                <label for="type" class="form-label small text-muted fw-bold">Report Type</label>
                                <select class="form-select" id="type" name="type">
                                    <option value="EXPENSE" <%= type === 'EXPENSE' ? 'selected' : '' %>>Expenses</option>
                                    <option value="INCOME" <%= type === 'INCOME' ? 'selected' : '' %>>Income</option>
                                </select>
                            </div>
                            
                            <!-- Text Search -->
                            <div class="col-md-3">
                                <label for="search" class="form-label small text-muted fw-bold">Search Description</label>
                                <input type="text" class="form-control" id="search" name="search" value="<%= search %>" placeholder="Keyword...">
                            </div>

                            <!-- Category Filter (visible for Expense only) -->
                            <div class="col-md-2" id="categoryFilterDiv" style="<%= type === 'INCOME' ? 'display:none;' : '' %>">
                                <label for="category" class="form-label small text-muted fw-bold">Category</label>
                                <select class="form-select" id="category" name="category">
                                    <option value="ALL" <%= category === 'ALL' ? 'selected' : '' %>>All Categories</option>
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <!-- Start Date -->
                            <div class="col-md-2">
                                <label for="startDate" class="form-label small text-muted fw-bold">Start Date</label>
                                <input type="date" class="form-control" id="startDate" name="startDate" value="<%= startDate %>">
                            </div>

                            <!-- End Date -->
                            <div class="col-md-2">
                                <label for="endDate" class="form-label small text-muted fw-bold">End Date</label>
                                <input type="date" class="form-control" id="endDate" name="endDate" value="<%= endDate %>">
                            </div>

                            <!-- Action Buttons -->
                            <div class="col-md-1 text-end">
                                <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Summaries (Category-wise breakdown & Current Month Summary cards) -->
                <div class="row g-4 mb-4">
                    
                    <!-- Monthly Overview Card -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-4 bg-white h-100">
                            <h5 class="fw-bold mb-4">Current Month Income vs Expense</h5>
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <tbody>
                                        <tr>
                                            <td><i class="bi bi-arrow-up-circle-fill text-success me-2"></i><strong>Monthly Income</strong></td>
                                            <td class="text-end text-success fw-bold">₹<%= formatDecimal(monthlyIncome) %></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-arrow-down-circle-fill text-danger me-2"></i><strong>Monthly Expense</strong></td>
                                            <td class="text-end text-danger fw-bold">₹<%= formatDecimal(monthlyExpense) %></td>
                                        </tr>
                                        <tr class="border-top-2">
                                            <td><strong>Net Savings</strong></td>
                                            <td class="text-end fw-bold fs-5 <%= (monthlyIncome - monthlyExpense) >= 0 ? 'text-success' : 'text-danger' %>">
                                                ₹<%= formatDecimal(monthlyIncome - monthlyExpense) %>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Category Breakdown Card -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-4 bg-white h-100">
                            <h5 class="fw-bold mb-3">Category-wise Expense Breakdown</h5>
                            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th class="text-end">Total Spent</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% categoryBreakdown.forEach(function(row) { %>
                                            <tr>
                                                <td><%= row[0] %></td>
                                                <td class="text-end text-danger fw-bold">₹<%= formatDecimal(row[1]) %></td>
                                            </tr>
                                        <% }); %>
                                        <% if (categoryBreakdown.length === 0) { %>
                                            <tr>
                                                <td colspan="2" class="text-center text-muted py-3">No expenses recorded for this month.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Report Results Card -->
                <div class="card border-0 shadow-sm p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Report Details</h5>
                        <div class="text-end">
                            <span class="text-muted me-2">Total Amount:</span>
                            <span class="fs-5 fw-bold <%= type === 'INCOME' ? 'text-success' : 'text-danger' %>">
                                ₹<%= formatDecimal(totalReportAmount) %>
                            </span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th><%= type === 'INCOME' ? 'Source' : 'Category' %></th>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reportData.forEach(function(row) { %>
                                    <tr>
                                        <td><%= formatDate(row.date) %></td>
                                        <td>
                                            <span class="fw-semibold"><%= type === 'INCOME' ? row.source : row.category %></span>
                                        </td>
                                        <td><%= row.description ? row.description : 'N/A' %></td>
                                        <td class="text-end fw-bold <%= type === 'INCOME' ? 'text-success' : 'text-danger' %>">
                                            <%= type === 'INCOME' ? '+₹' + formatDecimal(row.amount) : '-₹' + formatDecimal(row.amount) %>
                                        </td>
                                    </tr>
                                <% }); %>
                                <% if (reportData.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No matching records found. Refine your filters.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <%- include('partials/footer_scripts') %>
    
    <script>
        // Toggle Category Filter based on Report Type
        document.getElementById('type').addEventListener('change', function() {
            var div = document.getElementById('categoryFilterDiv');
            if (this.value === 'INCOME') {
                div.style.display = 'none';
            } else {
                div.style.display = '';
            }
        });
    </script>
</body>
</html>
